# /etc/vpn-node-monitor/vpn-node-monitor.env
# Скопируйте в /etc/vpn-node-monitor/vpn-node-monitor.env и chmod 600 (там токены).

# --- Пути вывода ---
METRICS_DIR="/var/lib/node_exporter/textfile_collector"
METRICS_FILE="${METRICS_DIR}/vpn_node.prom"
LOG_DIR="/var/log/vpn-node-monitor"
LOG_FILE="${LOG_DIR}/monitor.log"
STATE_DIR="/var/lib/vpn-node-monitor"

# --- WireGuard ---
WG_ENABLE="auto"          # auto — сам определит наличие `wg` и интерфейсов

# --- OpenVPN ---
OPENVPN_ENABLE="auto"
OPENVPN_STATUS_FILES="/etc/openvpn/openvpn-status.log /etc/openvpn/server/openvpn-status.log"

# --- Xray / VLESS ---
# Требует включённого Stats API в конфиге Xray:
#   "stats": {}, "api": {"tag":"api","services":["StatsService"]},
#   "policy": {"levels":{"0":{"statsUserUplink":true,"statsUserDownlink":true}}}
# и inbound на 127.0.0.1:10085 с protocol "dokodemo-door"/api.
XRAY_ENABLE="auto"
XRAY_BIN="/usr/local/bin/xray"
XRAY_API_ADDR="127.0.0.1:10085"
XRAY_INBOUND_PORTS="443"   # список портов через пробел, для подсчёта live-сессий

# --- systemd-юниты для проверки статуса (несуществующие пропускаются) ---
SYSTEMD_UNITS="xray xray.service sing-box wg-quick@wg0 wg-quick@wg1 openvpn@server openvpn remnawave-node"

# --- Приватность ---
LOG_USER_IDENTIFIERS="hash"   # hash (рекомендуется) | plain

# --- Пороги алертов ---
CPU_ALERT_PCT=90
MEM_ALERT_PCT=90
DISK_ALERT_PCT=90
LOAD_ALERT_MULT=2
CONNTRACK_ALERT_PCT=90
ALERT_REPEAT_MIN=30

# --- Telegram-алерты ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Central HTTP POST (опционально) ---
CENTRAL_POST_URL=""
CENTRAL_POST_TOKEN=""
CENTRAL_POST_TIMEOUT=10

NODE_TAG=""   # пусто = hostname -f
