# /etc/subscription-prober/subscription-prober.env
# chmod 600 — сюда попадёт central-токен.

# Ссылки на подписки через запятую (базовая base64-подписка, plain-список
# share-линков или sing-box JSON с "outbounds" — формат определяется автоматически)
SUB_PROBER_SUBSCRIPTIONS="https://your-panel.example.com/sub/xxxxxxxx"

# Какие сайты проверять через каждый прокси из подписки (через запятую)
SUB_PROBER_TARGETS="https://www.google.com,https://www.youtube.com,https://www.netflix.com,https://web.telegram.org,https://discord.com,https://chat.openai.com"

# Бинарник Xray-core (используется как клиентский движок для всех прокси разом)
SUB_PROBER_XRAY_BIN="/usr/local/bin/xray"

# Локальные SOCKS5-порты для каждого прокси нумеруются начиная с этого значения
SUB_PROBER_SOCKS_BASE_PORT=11000

# Таймаут одной проверки (сек) и параллелизм
SUB_PROBER_PROBE_TIMEOUT=8
SUB_PROBER_MAX_WORKERS=16

# Сколько ждать после старта xray перед началом проб (сек)
SUB_PROBER_XRAY_STARTUP_WAIT=1.5

# Ограничение на число прокси из подписки за один цикл (защита от очень длинных подписок)
SUB_PROBER_MAX_PROXIES=200

# Метка этого watcher-хоста, отображается в колонке "Prober-нода" на дашборде
SUB_PROBER_TAG="watcher-1"

# Куда слать результаты — тот же central-server, что принимает /ingest у нод
SUB_PROBER_CENTRAL_URL="https://monitor.example.com/ingest-probes"
SUB_PROBER_CENTRAL_TOKEN="тот же VPN_MON_PROBES_INGEST_TOKEN (или VPN_MON_INGEST_TOKEN), что на сервере"
