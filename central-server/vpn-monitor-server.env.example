# /etc/vpn-monitor-server/vpn-monitor-server.env
# chmod 600 — здесь токен и пароль дашборда.

VPN_MON_LISTEN=127.0.0.1        # 127.0.0.1 если ставите nginx-прокси перед ним (рекомендуется)
VPN_MON_PORT=8787
VPN_MON_INGEST_TOKEN=CHANGE_ME_RANDOM_TOKEN
VPN_MON_DASH_USER=admin
VPN_MON_DASH_PASS=CHANGE_ME_STRONG_PASSWORD
VPN_MON_STATE_FILE=/var/lib/vpn-monitor-server/state.json
VPN_MON_STALE_SEC=90
VPN_MON_DOWN_SEC=300

# Для subscription-prober (проверка сайтов через прокси из подписки)
# Если не задан — используется VPN_MON_INGEST_TOKEN
VPN_MON_PROBES_INGEST_TOKEN=CHANGE_ME_RANDOM_TOKEN_2
VPN_MON_PROBES_STATE_FILE=/var/lib/vpn-monitor-server/probes.json
VPN_MON_PROBES_STALE_SEC=600
