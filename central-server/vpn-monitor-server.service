[Unit]
Description=VPN fleet monitor — central dashboard/ingest server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/vpn-monitor-server/vpn-monitor-server.env
ExecStart=/usr/bin/python3 /usr/local/bin/vpn-monitor-server.py
Restart=on-failure
RestartSec=5
User=vpn-monitor
Group=vpn-monitor
ProtectSystem=strict
ReadWritePaths=/var/lib/vpn-monitor-server
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
